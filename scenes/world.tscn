[sub_resource type="GDScript" id="GDScript_qfnet"]
script/source = "extends CanvasModulate
## Day / night cycle. Tints the whole world through the day.
## Other scripts (shadows, fireflies...) can read time_of_day or call is_night().

signal night_started
signal day_started

@export var day_length_seconds := 600.0          # one full day = 10 minutes
@export_range(0.0, 1.0) var time_of_day := 0.30  # 0 = midnight, 0.25 = sunrise, 0.5 = noon, 0.75 = sunset

var sky := Gradient.new()
var _was_night := false


func _ready() -> void:
	add_to_group(\"day_night\")
	sky.offsets = PackedFloat32Array([0.0, 0.22, 0.30, 0.50, 0.70, 0.78, 0.86, 1.0])
	sky.colors = PackedColorArray([
		Color(\"2b4a5a\"),   # midnight
		Color(\"2b4a5a\"),   # before dawn
		Color(\"f2b88c\"),   # sunrise
		Color(\"fff6e6\"),   # noon
		Color(\"ffe2b8\"),   # afternoon
		Color(\"f09a7a\"),   # sunset
		Color(\"4a4f7a\"),   # dusk
		Color(\"2b4a5a\"),   # midnight again
	])
	_was_night = is_night()
	color = sky.sample(time_of_day)


func _process(delta: float) -> void:
	time_of_day = fmod(time_of_day + delta / day_length_seconds, 1.0)
	color = sky.sample(time_of_day)

	# tell the rest of the game when night starts / ends
	var night := is_night()
	if night != _was_night:
		_was_night = night
		if night:
			night_started.emit()
		else:
			day_started.emit()


func is_night() -> bool:
	return time_of_day < 0.24 or time_of_day > 0.82


## Game clock: returns the hour 0-23 (e.g. for showing \"6:00 AM\" on screen)
func get_hour() -> int:
	return int(time_of_day * 24.0)
"

